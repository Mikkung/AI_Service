# Staff Inbox authentication
# Generate AUTH_SECRET with: npx auth secret
AUTH_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=
STAFF_ALLOWED_EMAILS=
